# GriosAI defaults are local-only.
GRIOSAI_VAULT_DIR=~/GriosAI-vault
GRIOSAI_HOST=127.0.0.1
GRIOSAI_PORT=8765
GRIOSAI_OLLAMA_URL=http://127.0.0.1:11434
GRIOSAI_VISION_MODEL=qwen2.5vl:7b
GRIOSAI_API_TOKEN=
GRIOSAI_ALLOWED_HOSTS=
GRIOSAI_OBSIDIAN_URL=https://127.0.0.1:27124
GRIOSAI_OBSIDIAN_API_KEY=
GRIOSAI_OBSIDIAN_VERIFY_TLS=true
GRIOSAI_OBSIDIAN_TIMEOUT=10
GRIOSAI_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
GRIOSAI_MLFLOW_EXPERIMENT=GriosAI
GRIOSAI_MLFLOW_TRACKING_TOKEN=
GRIOSAI_MLFLOW_ALLOW_REMOTE=false
GRIOSAI_MLFLOW_TIMEOUT=10
