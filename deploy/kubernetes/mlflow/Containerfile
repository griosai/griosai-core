FROM python:3.12-slim

ARG MLFLOW_VERSION=3.1.0

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOME=/tmp

RUN groupadd --system --gid 10001 mlflow \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin mlflow \
    && python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir "mlflow==${MLFLOW_VERSION}" \
    && mkdir -p /mlflow/artifacts \
    && chown -R 10001:10001 /mlflow

USER 10001:10001

EXPOSE 5000
VOLUME ["/mlflow"]

CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////mlflow/mlflow.db", "--default-artifact-root", "/mlflow/artifacts"]
